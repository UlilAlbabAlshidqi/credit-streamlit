  "preprocessing": {
    "numeric_standard": {
      "kolom": [
        "LIMIT_BAL",
        "AGE",
        "BILL_AMT1",
        "BILL_AMT3",
        "BILL_AMT4",
        "BILL_AMT6"
      ],
      "imputer": "SimpleImputer(strategy=median)",
      "scaler": "StandardScaler"
    },
    "numeric_log": {
      "kolom": [
        "PAY_AMT1",
        "PAY_AMT2",
        "PAY_AMT3",
        "PAY_AMT4",
        "PAY_AMT5",
        "PAY_AMT6"
      ],
      "imputer": "SimpleImputer(strategy=median)",
      "transformasi": "np.log1p",
      "scaler": "RobustScaler"
    },
    "numeric_yeo_johnson": {
      "kolom": [
        "BILL_AMT2",
        "BILL_AMT5"
      ],
      "imputer": "SimpleImputer(strategy=median)",
      "transformasi": "PowerTransformer(method=yeo-johnson)",
      "standardize": false,
      "scaler": "RobustScaler"
    },
    "kategorikal_ordinal": {
      "kolom": [
        "PAY_0",
        "PAY_2",
        "PAY_3",
        "PAY_4",
        "PAY_5",
        "PAY_6"
      ],
      "konversi": "String",
      "imputer": {
        "strategy": "constant",
        "fill_value": "KOSONG"
      },
      "encoder": "OneHotEncoder",
      "handle_unknown": "ignore",
      "sparse_output": false
    },
    "kategorikal_nominal": {
      "kolom": [
        "SEX",
        "EDUCATION",
        "MARRIAGE"
      ],
      "konversi": "String",
      "imputer": {
        "strategy": "constant",
        "fill_value": "KOSONG"
      },
      "encoder": "OneHotEncoder",
      "handle_unknown": "ignore",
      "sparse_output": false
    },
    "keterangan": "Seluruh preprocessing berada dalam ColumnTransformer di pipeline model dan di-fit pada data training masing-masing fold."
  },
  "model": {
    "name": "CatBoost",
    "type": "CatBoostClassifier",
    "class_imbalance_handling": "auto_class_weights=Balanced",
    "selection_metric": "average_precision",
    "best_params": {
      "random_strength": 0.5,
      "learning_rate": 0.01,
      "l2_leaf_reg": 7,
      "iterations": 1000,
      "depth": 9,
      "border_count": 32
    },
    "best_cv_pr_auc": 0.5405156992669589,
    "cv": {
      "method": "StratifiedKFold",
      "n_splits": 5,
      "shuffle": true,
      "random_state": 42
    },
    "tuning": {
      "method": "RandomizedSearchCV",
      "n_iter": 30,
      "random_state": 42
    },
    "tuned": {
      "training_data": "80% (X_train, y_train)",
      "file": "model_tuned.joblib",
      "purpose": "Model untuk evaluasi pada test set yang dipisahkan sebelum cross-validation dan tuning."
    },
    "final": {
      "training_data": "100% data (X, y)",
      "file": "model_final.joblib",
      "purpose": "Model untuk inference atau deployment setelah eksperimen selesai."
    },
    "versions": {
      "scikit_learn": "1.6.1",
      "catboost": "1.2.10",
      "numpy": "2.1.3"
    }
  },
